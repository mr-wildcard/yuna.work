{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignoreDeps": ["tailwindcss", "@tailwindcss/vite"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "2 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "matchPackageNames": ["*"],
      "excludeDepTypes": ["packageManager"]
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "all major dependencies",
      "groupSlug": "all-major",
      "matchPackageNames": ["*"],
      "excludeDepTypes": ["packageManager"]
    },
    {
      "matchDepTypes": ["packageManager"],
      "groupName": "pnpm",
      "groupSlug": "pnpm",
      "automerge": false,
      "description": "Keep pnpm bumps off the grouped dep PRs; they change the tool, not a library"
    },
    {
      "matchPackageNames": ["node"],
      "groupName": "node",
      "groupSlug": "node",
      "automerge": false,
      "description": "Bump .nvmrc and devEngines together: Cloudflare Pages reads .nvmrc, pnpm reads devEngines"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0",
      "description": "TS 7 removes the programmatic API astro check needs; unpin once https://github.com/withastro/roadmap/discussions/1321 lands"
    }
  ]
}
