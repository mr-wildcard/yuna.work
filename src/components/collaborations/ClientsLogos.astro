---
import { Picture } from "astro:assets";
import Grid from "../@common/Grid.astro";

interface Props {
  clients: {
    logo: ImageMetadata;
    name: string;
    width: number;
    widthLg?: number;
  }[];
}

const { clients } = Astro.props;
---

<Grid
  as="ul"
  class="gap-y-7.5 gap-x-2.5 grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:gap-0 lg:flex lg:justify-center lg:flex-wrap lg:-mx-8.5 lg:-my-4 2xl:-mx-10"
>
  {
    clients.map((client) => (
      <li class="md:col-span-1 lg:col-span-2 h-16.5 flex justify-center items-center lg:mx-8.5 lg:my-4 2xl:mx-10">
        <Picture
          src={client.logo}
          densities={[1, 2]}
          alt={client.name}
          class="w-(--logo-width) lg:w-(--logo-width-lg)"
          style={{
            "--logo-width": `${client.width}px`,
            "--logo-width-lg": `${client.widthLg ?? client.width}px`,
          }}
        />
      </li>
    ))
  }
</Grid>
